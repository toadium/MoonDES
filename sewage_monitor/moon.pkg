import {
  "moonbitlang/async",
  "moonbitlang/async/http" @http,
  "moonbitlang/async/socket" @socket,
  "moonbitlang/async/stdio" @stdio,
  "moonbitlang/async/fs" @fs,
  "moonbitlang/async/io" @io,
  "moonbitlang/core/json" @json,
  "moonbitlang/core/strconv" @strconv,
  "walkzzz/moondes/core",
  "walkzzz/moondes/process",
  "walkzzz/moondes/random",
  "walkzzz/moondes/stats",
  "walkzzz/moondes/resource",
  "walkzzz/moondes/fsm",
  "walkzzz/moondes/eventbus",
  "walkzzz/moondes/pipeline",
  "walkzzz/moondes/simbuf",
  "walkzzz/moondes/mesh3d",
  "walkzzz/moondes/sim" @sim,
